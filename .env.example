# Nadie configuration surface.
# Copy to .env and fill in real values. Never commit the copy.
# Documented in docs/ARQUITECTURA.MD and docs/PLAN_BACKEND.md (Goal 5).

# HashKey Chain Testnet (chain ID 133) JSON-RPC endpoint.
HASHKEY_RPC_URL=
HASHKEY_CHAIN_ID=133

# Deployed registry addresses (filled by Goal 5).
PROFESSIONAL_REGISTRY_ADDRESS=
CONSENT_REGISTRY_ADDRESS=

# Relayer signing key: 0x-prefixed 32-byte hex. Testnet only, never a real key.
RELAYER_PRIVATE_KEY=

# Off-chain services.
GATEWAY_URL=
RELAYER_URL=