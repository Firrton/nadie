# Nadie configuration surface.
# Copy to .env and fill in real values. Never commit the copy.
# Documented in docs/ARQUITECTURA.MD and docs/PLAN_BACKEND.md (Goal 5).

# HashKey Chain Testnet (chain ID 133) JSON-RPC endpoint.
HASHKEY_RPC_URL=https://testnet.hsk.xyz
HASHKEY_CHAIN_ID=133

# Deployer: testnet-only key, 0x-prefixed. Never a real key. Never commit.
# The deployer becomes the immutable admin of ProfessionalRegistry.
DEPLOYER_PRIVATE_KEY=

# ProfessionalRegistry configuration.
PROFESSIONAL_VERIFIER_ADDRESS=
KYC_ADAPTER_ADDRESS=
KYC_MINIMUM_LEVEL=0

# Deployed registry addresses (HashKey Chain Testnet, chain ID 133).
# Verified on-chain after the Goal 5 broadcast; explorer:
# https://testnet-explorer.hsk.xyz
PROFESSIONAL_REGISTRY_ADDRESS=0xD615074c2603336fa0Da8AF44B5CCB9D9C0B2F9c
CONSENT_REGISTRY_ADDRESS=0xdc3c4c07e4675cf1BBDEa627026e92170f9F5AE1

# Relayer signing key: 0x-prefixed 32-byte hex. Testnet only, never a real key.
RELAYER_PRIVATE_KEY=

# Off-chain services.
GATEWAY_URL=
RELAYER_URL=
