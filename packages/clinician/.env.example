# Local Anvil demo. Contract addresses are produced by the local deployment.
VITE_CHAIN_ID=133
VITE_RPC_URL=http://127.0.0.1:8545
VITE_CONSENT_REGISTRY_ADDRESS=
VITE_PROFESSIONAL_REGISTRY_ADDRESS=
VITE_GRANTED_FROM_BLOCK=0

# The browser uses the same-origin Vite proxy so the user app and this portal
# do not have to compete for the gateway's single allowed CORS origin.
VITE_GATEWAY_URL=/api/gateway
VITE_GATEWAY_PROXY_TARGET=http://127.0.0.1:8787
