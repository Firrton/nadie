# Person's app. Copy to .env.local and fill in. Never commit the copy.
# If any sharing variable is missing, the app runs without the share button.

# Optional: serve model weights from your own host instead of Hugging Face.
# VITE_MODELOS_BASE=http://127.0.0.1:8899

# HashKey Chain Testnet (chain ID 133).
VITE_HASHKEY_RPC_URL=https://testnet.hsk.xyz
VITE_EXPLORER_URL=https://testnet-explorer.hsk.xyz
VITE_CONSENT_REGISTRY_ADDRESS=0xdc3c4c07e4675cf1BBDEa627026e92170f9F5AE1
VITE_PROFESSIONAL_REGISTRY_ADDRESS=0xD615074c2603336fa0Da8AF44B5CCB9D9C0B2F9c

# Off-chain services.
VITE_GATEWAY_URL=http://localhost:8787
VITE_RELAYER_URL=http://localhost:8788

# Wallet address of the verified psychologist who receives the shares.
VITE_PSICOLOGA_ADDRESS=
