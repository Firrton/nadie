{
  "name": "@nadie/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nadie mobile voice app. Mobile-first, dark only, Spanish.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "pnpm --filter @nadie/core build && vite build",
    "preview": "vite preview",
    "test": "pnpm --filter @nadie/core build && TZ=America/Mexico_City vitest run --exclude '**/e2e/**'",
    "test:watch": "pnpm --filter @nadie/core build && TZ=America/Mexico_City vitest --exclude '**/e2e/**'",
    "test:e2e": "pnpm run build && vitest run test/e2e",
    "banco": "vite --port 5174 --strictPort --host 127.0.0.1",
    "banco:modelos": "node banco/servidor-local.mjs"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "0.2.85",
    "@nadie/core": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "playwright": "1.63.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  }
}
