{
  "name": "@nadie/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nadie encrypted package gateway: stores ciphertext, releases only on a valid on-chain grant.",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit false && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@nadie/core": "workspace:*",
    "hono": "4.13.7",
    "viem": "2.56.3",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "tsx": "4.23.13",
    "vitest": "3.2.7"
  }
}