{
  "name": "@nadie/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nadie core: public contracts, ports and runtime schemas. No implementations.",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit false && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "vitest": "^3.2.7"
  }
}
