{
  "name": "@nadie/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nadie core: contracts, runtime schemas and the v1 encrypted-package format. No implementations of ports.",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit false && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@hpke/core": "1.9.0",
    "@noble/hashes": "2.3.0",
    "@scure/base": "2.2.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "vitest": "^3.2.7"
  }
}
